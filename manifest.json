{
  "manifest_version": 3,
  "name": "282 CHDS BYPASS",
  "description": "Automated Facebook/Meta appeal submission (8 forms + refreshes).",
  "version": "1.0",

  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{e3a9c7a1-6a1f-4f2b-9b4e-9b5f3d2c1a7c}"
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/help/contact/*",
        "https://www.meta.com/help/policies/*"
      ],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  }
}
